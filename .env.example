# 로컬 개발용 환경 변수 예시
# 이 파일을 복사해 .env로 만들고 값을 채운다. .env는 커밋하지 않는다(.gitignore에 포함).
POSTGRES_DB=warmap
POSTGRES_USER=warmap
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# 로그인 (카카오 개발자 콘솔, 구글 클라우드 콘솔에서 받는다)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 브라우저가 여는 주소. 로그인 뒤 돌아올 주소의 앞부분
APP_BASE_URL=http://localhost:3000
# JWT 서명 키(Base64, 32바이트 이상). Git Bash에서 openssl rand -base64 32 로 만든다
JWT_SECRET=
