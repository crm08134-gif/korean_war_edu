# 운영 서버용 환경 변수 예시. 서버에서 이 파일을 복사해 .env로 만들고 값을 채운다 (cp .env.example .env)
# .env는 서버에만 둔다. 커밋하지 않는다. 로컬 .env의 값을 그대로 쓰지 않는다.

# DB. 비밀번호는 서버에서 새로 만든다: openssl rand -base64 24
POSTGRES_DB=warmap
POSTGRES_USER=warmap
POSTGRES_PASSWORD=

# 운영 주소. 카카오·구글 콘솔의 돌아올 주소도 이 주소로 등록한다
APP_BASE_URL=https://koreanwar-edu.tech

# 로그인 (카카오 개발자 콘솔, 구글 클라우드 콘솔)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT 서명 키. 서버에서 새로 만든다(로컬 값 재사용 금지): openssl rand -base64 32
JWT_SECRET=

# AI 질문. 비워 두면 질문 기능이 꺼진다(503)
GEMINI_API_KEY=
