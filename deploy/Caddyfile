# 이 도메인으로 오는 요청을 HTTPS로 받아 안쪽 컨테이너로 넘긴다.
# 인증서(Let's Encrypt)는 Caddy가 자동으로 받고 갱신한다.
koreanwar-edu.tech {
	encode zstd gzip

	# 백엔드(Spring)가 처리하는 주소는 Next를 거치지 않고 바로 넘긴다.
	# Next가 수백 KB 응답을 중계하느라 CPU를 쓰던 것(k6 50명에서 frontend 평균 60%)을 없앤다.
	# 로컬 개발(npm run dev)은 frontend/next.config.ts의 rewrites가 같은 일을 한다. 주소를 늘리면 둘 다 고친다.
	@backend path /api/* /photos/* /oauth2/* /login/oauth2/*
	handle @backend {
		reverse_proxy backend:8080
	}

	# 그 밖의 요청(화면, JS·CSS, 아이콘)은 Next로
	handle {
		reverse_proxy frontend:3000
	}
}
