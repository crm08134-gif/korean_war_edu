# 로컬 용량 실험용. 복사해서 .env로 쓰고 값을 채운다: cp .env.example .env
# 진짜 키를 넣지 않는다(로그인·AI는 부르지 않으므로 가짜 값이면 된다)
POSTGRES_DB=koreanwar
POSTGRES_USER=koreanwar
POSTGRES_PASSWORD=아무-난수
APP_BASE_URL=https://localhost:8443
KAKAO_CLIENT_ID=fake
KAKAO_CLIENT_SECRET=fake
GOOGLE_CLIENT_ID=fake
GOOGLE_CLIENT_SECRET=fake
# 32바이트 이상 난수. 예: openssl rand -base64 48
JWT_SECRET=
GEMINI_API_KEY=
# 관측(로컬 전용): /actuator/prometheus를 열고, 요청 시간 히스토그램과 Tomcat 스레드 지표를 켠다
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
# 이름에 하이픈(percentiles-histogram)이 있어 환경 변수 한 줄로는 못 쓴다 → JSON으로 넘긴다
SPRING_APPLICATION_JSON={"management.metrics.distribution.percentiles-histogram.http.server.requests":true}
SERVER_TOMCAT_MBEANREGISTRY_ENABLED=true
